# Backend environment variables for Face Recognition Based Attendance System

# App settings
APP_NAME=Face Detection Attendance System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=replace_with_a_secure_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# Database settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendance_db
DB_ECHO=False

# CORS settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Face recognition settings
FACE_MODEL_NAME=Facenet
FACE_DISTANCE_THRESHOLD=0.40
LIVENESS_CHECK_ENABLED=True
EMBEDDING_DIMENSIONS=128

# Blockchain settings
BLOCKCHAIN_URL=http://127.0.0.1:8545
BLOCKCHAIN_ENABLED=False

# Geofencing settings
GEOFENCE_ENABLED=False
GEOFENCE_RADIUS_METERS=50

# Email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@attendance.local

# Cache & rate limiting
CACHE_DIR=/tmp/visioncore_cache
REDIS_URL=redis://localhost:6379/0
